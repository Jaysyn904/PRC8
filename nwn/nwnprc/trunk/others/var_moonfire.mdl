#MAXMODEL ASCII
# Native Sunbeam travelling streaks, attached by spells.2da CastHandVisual.
# Source: stock vff_explsun spark_beam01 (cores) and spark_beam (soft scatter).
# cast01 timing: native var_conecold, paired with CastTime 1700.
# +Y is forward. Five centerlines meet y=18.28, x=-9.14..9.14, z=-1.2.
# The 1.2m drop approximates hand height; it is visual, not damage geometry.
# Fountain/Motion_Blur, texture, density, blur, sizes and alpha remain native.
# Color is pure white. No Lightning/Linked, P2P endpoints or dynamic lights.
filedependancy var_moonfire.max
newmodel var_moonfire
setsupermodel var_moonfire NULL
classification EFFECT
setanimationscale 1
#MAXGEOM ASCII
beginmodelgeom var_moonfire
node dummy var_moonfire
  parent NULL
