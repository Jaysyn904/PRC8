#MAXMODEL ASCII
# model: vim_moonimpact
# Moon-white derivative of the stock Sunstrike impact. Geometry and timing
# retain the dense burst while every warm emitter/light is pale moonlight.
filedependancy vim_moonimpact.max
newmodel vim_moonimpact
setsupermodel vim_moonimpact NULL
classification EFFECT
ignorefog 1
setanimationscale 1

