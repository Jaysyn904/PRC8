/***************************************************** Feat: Riddle of Awareness* Discription: Once per day: +4 to Listen, Search &* Spot checks for 10 hours.** by Jeremiah Teague* spl_rdlawr****************************************************/void main(){    effect eLink = EffectVisualEffect(VFX_DUR_PROT_PREMONITION);           eLink = EffectLinkEffects(eLink, EffectSkillIncrease(SKILL_LISTEN, 4));           eLink = EffectLinkEffects(eLink, EffectSkillIncrease(SKILL_SEARCH, 4));           eLink = EffectLinkEffects(eLink, EffectSkillIncrease(SKILL_SPOT, 4));    ApplyEffectToObject(DURATION_TYPE_TEMPORARY, eLink, OBJECT_SELF, HoursToSeconds(10));}